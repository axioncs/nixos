{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "nixos2",
        "padding": {
            "top": 1
        }
    },
    "display": {
        "separator": " ›  "
    },
    "modules": [
        "break",
        "break",
        "title",
        "break",
        {
            "type": "os",
            "key": "OS  ",
            "keyColor": "33"
        },
        {
            "type": "command",
            "key": "GEN ",
            "keyColor": "34",
            "text": "echo \"Generation $(readlink /nix/var/nix/profiles/system | sed 's/.*-\\([0-9]*\\)-link/\\1/')\""
        },
        {
            "type": "kernel",
            "key": "KER ",
            "keyColor": "33"
        },
        {
            "type": "packages",
            "key": "PKG ",
            "keyColor": "34"
        },
        {
            "type": "shell",
            "key": "SH  ",
            "keyColor": "33"
        },
        {
            "type": "terminal",
            "key": "TER ",
            "keyColor": "34"
        },
        {
            "type": "wm",
            "key": "WM  ",
            "keyColor": "33"
        },
        {
            "type": "uptime",
            "key": "UP  ",
            "keyColor": "34"
        },
        {
            "type": "command",
            "key": "CPU ",
            "keyColor": "33",
            "text": "echo \"$(grep -m1 'model name' /proc/cpuinfo | sed 's/.*: //; s/ w\\/.*//') @ $(lscpu | awk '/CPU max MHz/ {printf \"%.2f GHz\", $4/1000}')\""
        },
        {
            "type": "gpu",
            "key": "GPU ",
            "keyColor": "34"
        },
        {
            "type": "memory",
            "key": "RAM ",
            "keyColor": "33"
        },
        "break",
        "colors",
        "break"
    ]
}
