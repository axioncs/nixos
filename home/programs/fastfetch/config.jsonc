{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
      "source": "nixos2",
      "padding": {
	        "top": 1
    },
    },
    "display": {
            "separator": " ›  "
        },
        "modules": [
        	"break",
       	"title",
        "break",
        {
            "type": "os",
            "key": "OS  ",
            "keyColor": "31",  // = color1
        },
        {
            "type": "command",
            "key": "GEN ",
            "keyColor": "32",
            "text": "echo \"Generation $(readlink /nix/var/nix/profiles/system | sed 's/.*-\\([0-9]*\\)-link/\\1/')\""
        },
        {
            "type": "kernel",
            "key": "KER ",
            "keyColor": "33",
        },
        {
            "type": "packages",
            "key": "PKG ",
            "keyColor": "34",
        },
        {
            "type": "shell",
            "key": "SH  ",
            "keyColor": "35",
        },
        {
            "type": "terminal",
            "key": "TER ",
            "keyColor": "36",
        },
        {
            "type": "wm",
            "key": "WM  ",
            "keyColor": "31",
        },
        {
            "type": "uptime",
            "key": "UP  ",
            "keyColor": "32",
        },
        {
            "type": "cpu",
            "key": "CPU ",
            "keyColor": "33",
        },
        {
            "type": "gpu",
            "key": "GPU ",
            "keyColor": "34",
        },
        {
            "type": "memory",
            "key": "RAM ",
            "keyColor": "35",
        },
        "break",
        "break",
        "colors",
        "break",
    ]
}
